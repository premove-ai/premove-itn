{
  "description": "Repository-owned RTK shell-output compression hook.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project python \"$(git rev-parse --show-toplevel)/scripts/agent/rtk_hook.py\"",
            "timeout": 5,
            "statusMessage": "Applying RTK output compression"
          }
        ]
      }
    ]
  }
}
